# Defaults are credential-free, localhost-only, synthetic mock mode.
GILM_DEV_MODE=true
GILM_HOST=127.0.0.1
GILM_DATA_DIR=data
GILM_DEFAULT_PROVIDER=mock
GILM_TIMEOUT_SECONDS=30
GILM_RETENTION_DAYS=7

# Required when GILM_DEV_MODE=false. Supply real keys through your secret manager.
# Shape: {"your-key":{"tenant":"demo","branches":["North","South"],"can_manage":true}}
GILM_API_KEYS={}

# External calls are disabled until all of these are explicitly configured.
# Full HTTPS chat/completions endpoint; redirects are rejected.
GILM_HTTP_URL=
GILM_HTTP_KEY=
GILM_HTTP_MODELS=
GILM_HTTP_CA_FILE=
# Off by default; only exact localhost/127.0.0.1/::1 endpoints can use this exception.
GILM_ALLOW_LOOPBACK_HTTP=false
# Enforce explicit :free IDs, zero upstream prices, and no provider fallback.
GILM_OPENROUTER_FREE_ONLY=false
# USD per million tokens. Supply your provider's versioned rate card.
# Live evaluation also requires a provider-enforced input_token_ceiling.
# Quote the entire JSON value in dotenv files to preserve its inner quotes.
# Shape: '{"your-model":{"input":1,"cached_input":0.1,"output":2,"version":"your-version","input_token_ceiling":32768}}'
GILM_HTTP_PRICING={}
# An existing GILM management key, required by the live CLI outside dev mode.
GILM_BENCHMARK_KEY=

# Optional positive divisor for allocating the latest evaluation's estimated cost.
# Empty means lifecycle cost is unknown; local compute is always reported separately.
GILM_EVALUATION_AMORTIZATION_TASKS=

# Real LOCAL inference with an already-installed model. No download or cloud model.
GILM_DEV_MODE=true
GILM_HOST=127.0.0.1
GILM_DATA_DIR=data/ollama-qwen
GILM_DEFAULT_PROVIDER=http
GILM_ALLOW_LOOPBACK_HTTP=true
GILM_HTTP_URL=http://127.0.0.1:11434/v1/chat/completions
# Ollama ignores this placeholder; it is not a credential.
GILM_HTTP_KEY=ollama-local-placeholder
GILM_HTTP_MODELS=qwen2.5:1.5b
GILM_HTTP_PRICING='{"qwen2.5:1.5b":{"input":0,"cached_input":0,"output":0,"version":"local-ollama-no-api-fee-v1","input_token_ceiling":32768}}'
GILM_TIMEOUT_SECONDS=120
GILM_API_KEYS={}
